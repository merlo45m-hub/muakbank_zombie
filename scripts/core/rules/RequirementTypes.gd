static func get_def(type_id: int) -> Dictionary:
	var defs: Dictionary = get_parameter_definitions()
	if defs.has(type_id):
		return defs[type_id] as Dictionary
	return {
		"name": "Unknown_%d" % type_id,
		"category": CAT_EXTENDED,
		"default": false,
		"desc": "Undefined parameter %d" % type_id
	}


static func get_id_by_name(param_name: String) -> int:
	var defs: Dictionary = get_parameter_definitions()
	for id in defs.keys():
		if String(defs[id]["name"]).to_lower() == param_name.to_lower():
			return int(id)
	return -1
