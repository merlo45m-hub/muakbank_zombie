anchors_preset = 15
color = Color(0.08, 0.03, 0.12, 1)

[node name="PanelContainer" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
offset_left = 80.0
offset_top = 60.0
offset_right = -80.0
offset_bottom = -60.0
theme_overrides/styles/panel = SubResource("PanelStyle")

[node name="VBoxMain" type="VBoxContainer" parent="PanelContainer"]
