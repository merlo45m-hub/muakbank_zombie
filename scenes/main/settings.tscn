[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/Settings.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
bg_color = Color(0.12, 0.06, 0.18, 1.0)
