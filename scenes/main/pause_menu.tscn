[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 1
anchors_preset = 15
alignment = 1

[node name="Spacer1" type="Control" parent="Panel/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="Title" type="Label" parent="Panel/VBox"]
layout_mode = 2
