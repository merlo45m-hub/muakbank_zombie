[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/LevelSelect.gd" id="1"]

[node name="LevelSelect" type="Control"]
layout_mode = 1
anchors_preset = 15
script = ExtResource("1")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
color = Color(0.08, 0.03, 0.12, 1)

[node name="VBoxMain" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="VBoxMain"]
layout_mode = 2
text = "SELECT LEVEL"
theme_override_font_sizes/font_size = 48
theme_override_colors/font_color = Color(1.0, 0.2, 0.5, 1.0)
horizontal_alignment = 1
custom_minimum_size = Vector2(0, 60)

[node name="ScrollContainer" type="ScrollContainer" parent="VBoxMain"]
layout_mode = 2
size_flags_vertical = 3
custom_minimum_size = Vector2(0, 250)

[node name="GridContainer" type="GridContainer" parent="VBoxMain/ScrollContainer"]
layout_mode = 2
columns = 5
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16

[node name="PaginationContainer" type="HBoxContainer" parent="VBoxMain"]
layout_mode = 2
alignment = 1
custom_minimum_size = Vector2(0, 40)

[node name="PrevBtn" type="Button" parent="VBoxMain/PaginationContainer"]
layout_mode = 2
text = "◀ PREV"
custom_minimum_size = Vector2(100, 40)
theme_overrides/font_sizes/font_size = 16

[node name="PageLabel" type="Label" parent="VBoxMain/PaginationContainer"]
layout_mode = 2
text = "Page 1"
theme_override_font_sizes/font_size = 18
custom_minimum_size = Vector2(80, 0)
horizontal_alignment = 1
vertical_alignment = 1

[node name="NextBtn" type="Button" parent="VBoxMain/PaginationContainer"]
layout_mode = 2
text = "NEXT ▶"
custom_minimum_size = Vector2(100, 40)
theme_overrides/font_sizes/font_size = 16

[node name="ButtonContainer" type="HBoxContainer" parent="VBoxMain"]
layout_mode = 2
alignment = 1
custom_minimum_size = Vector2(0, 50)

[node name="BackBtn" type="Button" parent="VBoxMain/ButtonContainer"]
layout_mode = 2
text = "⬅ BACK"
custom_minimum_size = Vector2(150, 50)
theme_overrides/font_sizes/font_size = 20

[connection signal="pressed" from="VBoxMain/PaginationContainer/PrevBtn" to="." method="_on_prev"]
[connection signal="pressed" from="VBoxMain/PaginationContainer/NextBtn" to="." method="_on_next"]
[connection signal="pressed" from="VBoxMain/ButtonContainer/BackBtn" to="." method="_on_back"]
