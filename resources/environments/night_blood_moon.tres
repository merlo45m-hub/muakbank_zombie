[sub_resource type="Sky" id="Sky_blood"]
sky_material = SubResource("SkyMat_blood")

[resource]
background_mode = 2
sky = SubResource("Sky_blood")
ambient_light_source = 3
ambient_light_color = Color(0.44, 0.5, 0.72, 1)
ambient_light_sky_contribution = 0.35
; Was 1.0 with sky_contribution 0.65, off a sky whose horizon is (0.29, 0.1, 0.1): a full
; ambient term on every surface in the game. Measured from a rendered frame, the ground
; (authored albedo 0.16, level lights ~1.1 total) read rgb(110-132) where the material can
; only reach about 45/255 - that gap is this value. NightSky carries this environment as a
; top-level node in game.tscn, so it overrides every level's own WorldEnvironment: this one
; file is what the whole game renders through. NOTE: '#' is NOT a comment here - it silently
; discards the rest of the file, leaving every property at its default.
ambient_light_energy = 0.28
fog_enabled = true
fog_light_color = Color(0.19, 0.13, 0.16, 1.0)
fog_light_energy = 1.0
; Was 0.1 - a pea-souper that flattened every level to a smooth wash. 0.02 keeps the
; blood-moon haze on the horizon without dissolving the geometry.
fog_density = 0.02
tonemap_mode = 2
tonemap_white = 6.0
adjustment_enabled = true
adjustment_brightness = 1.0
adjustment_contrast = 1.1
adjustment_saturation = 0.96