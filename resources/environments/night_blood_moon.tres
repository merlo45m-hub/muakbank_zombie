[gd_resource type="Environment" format=3]

[sub_resource type="ProceduralSkyMaterial" id="SkyMat_blood"]
sky_top_color = Color(0.02, 0.024, 0.055, 1)
sky_horizon_color = Color(0.29, 0.1, 0.1, 1)
sky_curve = 0.14
sky_energy_multiplier = 0.9
ground_bottom_color = Color(0.014, 0.016, 0.024, 1)
ground_horizon_color = Color(0.14, 0.05, 0.06, 1)

[sub_resource type="Sky" id="Sky_blood"]
sky_material = SubResource("SkyMat_blood")

[resource]
background_mode = 2
sky = SubResource("Sky_blood")
ambient_light_source = 3
ambient_light_color = Color(0.44, 0.5, 0.72, 1)
ambient_light_sky_contribution = 0.35
; Was 1.0 with sky_contribution 0.65, off a sky whose horizon is (0.29, 0.1, 0.1): a full
; ambient term on every surface in the game. Measured from a rendered frame, the ground
; (authored albedo 0.16, level lights ~1.1 total) read rgb(110-132) where the material can
; only reach about 45/255 - that gap is this value. NightSky carries this environment as a
; top-level node in game.tscn, so it overrides every level's own WorldEnvironment: this one
; file is what the whole game renders through. NOTE: '#' is NOT a comment here - it silently
; discards the rest of the file, leaving every property at its default.
ambient_light_energy = 0.28
tonemap_mode = 2
tonemap_white = 6.0
fog_enabled = true
fog_light_color = Color(0.19, 0.13, 0.16, 1)
; Was 0.1 - a pea-souper that flattened every level to a smooth wash. 0.02 keeps the
; blood-moon haze on the horizon without dissolving the geometry.
; --- Issue #9 Phase 1: Lighting & Atmosphere (mobile-safe ground mist) ---------------
; Reference photos #12/#13 call for heavy graveyard fog. Volumetric fog would violate
; DESIGN.md section 6 (<=3 real-time lights, 60 FPS S26 Ultra, mobile renderer), so
; Phase 1 uses Godot's cheap height-based fog: ground-hugging mist that fades with
; altitude, plus moon/sun scatter and aerial perspective. No new lights or draw calls.
; fog_mode = 0 (EXPONENTIAL) is the engine default, omitted by ResourceSaver.
; Re-serialized by ResourceSaver so fog_density is genuinely 0.02, not the 1.0 default
; that a hand-authored property-ordering mistake produced.
fog_sun_scatter = 0.18
fog_density = 0.02
fog_aerial_perspective = 0.25
fog_sky_affect = 0.3
fog_height = 1.5
fog_height_density = 0.42
fog_depth_curve = 1.2
fog_depth_begin = 6.0
fog_depth_end = 90.0
adjustment_enabled = true
adjustment_contrast = 1.1
adjustment_saturation = 0.96
